{
  "name": "openphotoid-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "OpenPhotoId as a plain web page: the same Rust core compiled to WebAssembly, running entirely in the browser.",
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "dev": "vite",
    "preview": "vite preview --port 8082",
    "e2e": "playwright test",
    "serve": "node e2e/server.mjs",
    "screenshots": "node e2e/capture.mjs screenshots",
    "assets": "node scripts/make-assets.mjs",
    "e2e:devices": "playwright test -c playwright.mobile.config.js",
    "screenshots:mobile": "node e2e/capture-mobile.mjs screenshots/mobile"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "onnxruntime-web": "^1.20.1"
  }
}
