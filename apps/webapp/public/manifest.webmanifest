{
  "name": "OpenPhotoId — passport and ID photos",
  "short_name": "OpenPhotoId",
  "description": "Make a compliant passport, visa or ID photo on your own device. Free, and nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f2f2f2",
  "theme_color": "#f2f2f2",
  "categories": ["photo", "utilities", "productivity"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
